# 앱 메타
APP_NAME="JJan Fit Backend"
APP_VERSION="0.1.0"
DEBUG=false

# 서버
HOST=0.0.0.0
PORT=8000

# CORS (콤마 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 인증 (login 기능 추가 시 사용)
# JWT_SECRET=change-me-in-real-env
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60

# DB (MySQL 8.x + asyncmy) — 본인 로컬 값은 .env 에 작성
DATABASE_URL=mysql+asyncmy://USER:PASSWORD@localhost:3306/jjanfit
DATABASE_ECHO=false

# 기동 시 누락 테이블 자동 생성 여부.
#  - true  : 로컬 개발용. 없는 테이블만 생성 (기존 테이블/컬럼은 안 건드림)
#  - false : 아무것도 안 함. 운영/스테이징/CI 는 반드시 false
DATABASE_AUTO_CREATE=false
